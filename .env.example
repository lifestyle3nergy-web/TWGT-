# Example environment variables for TWGT

# Devin AI
DEVIN_API_URL=https://api.devin.example/ai
DEVIN_API_KEY=your_devin_api_key_here

# Database (Postgres)
DATABASE_URL=postgresql://postgres:password@db:5432/twgt

# Vector DB / Qdrant
QDRANT_URL=http://qdrant:6333

# JWT
JWT_SECRET=replace_this_with_a_strong_secret

# App
PORT=3000

