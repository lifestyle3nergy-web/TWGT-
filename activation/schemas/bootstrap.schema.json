{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "twgt://activation/schemas/bootstrap.schema.json",
  "title": "TWGT Bootstrap Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "commit",
    "rollbackPin",
    "repository",
    "nucleusId",
    "nucleusTag",
    "nucleusVersion",
    "digests",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "rollbackPin": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "repository": { "type": "string", "minLength": 1 },
    "nucleusId": { "type": "string", "minLength": 1 },
    "nucleusTag": { "type": "string", "minLength": 1 },
    "nucleusVersion": { "type": "string", "minLength": 1 },
    "digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
