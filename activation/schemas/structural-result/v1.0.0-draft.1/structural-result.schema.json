{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TWGT Structural Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_head_sha", "result", "authorizing", "checks"],
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft.1"
    },
    "candidate_head_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "result": {
      "const": "STRUCTURALLY_VALID"
    },
    "authorizing": {
      "const": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "result", "reason_code"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": ["PASS", "FAIL", "SKIPPED", "UNAVAILABLE"]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
