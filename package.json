{
  "name": "twgt-platform",
  "version": "1.0.0",
  "description": "TWGT Engineering Intelligence Platform - Phase 1 Foundation",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc && node scripts/resolve-dist-imports.mjs",
    "start": "node dist/index.js",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test tests/tooling/*.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "validate:source-boundary": "node scripts/validate-source-boundary.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "5.12.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^6.2.0",
    "openai": "^7.15.0",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3",
    "pg": "^8.23.0",
    "redis": "^4.6.12",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "mysql2": "^3.24.4"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
